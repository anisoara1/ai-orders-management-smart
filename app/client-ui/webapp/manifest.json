{
    "_version": "1.65.0",
    "sap.app": {
        "id": "ai.orders.client",
        "type": "application",
        "title": "Customer Portal",
        "description": "Customer Order Portal",
        "dataSources": {
            "mainService": {
                "uri": "https://ai-orders-management-smart.onrender.com/odata/v4/orders/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "ai.orders.client.view.Client",
            "type": "XML",
            "async": true,
            "id": "client"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.f": {},
                "sap.ui.layout": {}
            }
        },
        "models": {
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true
                }
            }
        }
    }
}
